# ============================================================
# Certus — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Application ---
NODE_ENV=development
APP_URL=http://localhost:3000
GATEWAY_URL=http://localhost:4000
GATEWAY_PORT=4000
RATE_LIMIT_REQUESTS_PER_MINUTE=100
INGESTION_SERVICE_URL=http://localhost:8001
ORCHESTRATION_SERVICE_URL=http://localhost:8002
MCP_TOOLS_URL=http://localhost:8003
# Browser-reachable WebSocket base. Routes such as /chat, /notifications, and /realtime
# are appended by the client. Leave empty in production when the public proxy
# upgrades same-origin /gateway/ws/* requests.
NEXT_PUBLIC_GATEWAY_WS_URL=ws://localhost:4000/ws
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Set this to the immutable source revision/image digest in deployed builds so
# parser and chunker derivations record the exact producer revision.
CERTUS_BUILD_REVISION=unversioned-development

# --- Better Auth ---
# Required in every environment. Local setup generates this value automatically.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
AUTH_SERVICE_URL=http://localhost:3000
INTERNAL_SERVICE_TOKEN=
AUTH_SERVICE_TIMEOUT_MS=5000
# Gateway dependency probes run concurrently and never expose failure details.
READINESS_PROBE_TIMEOUT_MS=5000

# --- Outbound webhooks ---
# Use a distinct random value of at least 32 characters in production. Local
# development falls back to a derived internal-service key only when this is empty.
WEBHOOK_ENCRYPTION_KEY=
# Never enable private targets outside isolated local development/tests.
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# --- OAuth Providers ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- PostgreSQL (pgvector) ---
DATABASE_URL=postgresql://nexus:nexus_dev_password@localhost:5432/nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_dev_password
POSTGRES_DB=nexus
# Maximum time a release waits for the database-wide migration owner. The
# runner fails closed instead of racing another deployer after this bound.
MIGRATION_LOCK_TIMEOUT_SECONDS=300
# Process-owned orchestration pools are bounded. Size these with worker count so
# the total stays below the database connection budget.
ORCHESTRATION_DB_POOL_MIN_SIZE=1
ORCHESTRATION_DB_POOL_MAX_SIZE=12
ORCHESTRATION_DB_POOL_ACQUIRE_TIMEOUT_SECONDS=2
# Better Auth and Web route handlers share this process-owned node-postgres
# pool. connectionTimeoutMillis also bounds a checkout wait when the pool is
# full; PostgreSQL independently enforces statement, lock, and idle-tx limits.
WEB_DB_POOL_MAX_SIZE=10
WEB_DB_ACQUIRE_CONNECT_TIMEOUT_MS=3000
WEB_DB_IDLE_TIMEOUT_MS=30000
WEB_DB_STATEMENT_TIMEOUT_MS=10000
WEB_DB_LOCK_TIMEOUT_MS=3000
WEB_DB_IDLE_TRANSACTION_TIMEOUT_MS=10000
WEB_DB_MAX_LIFETIME_SECONDS=300
# Connection establishment is bounded separately from pool acquisition and
# SQL statement deadlines. Each process labels its PostgreSQL connections.
ORCHESTRATION_DB_CONNECT_TIMEOUT_SECONDS=3
INGESTION_DB_CONNECT_TIMEOUT_SECONDS=3
MCP_DB_CONNECT_TIMEOUT_SECONDS=3
MCP_DB_STATEMENT_TIMEOUT_MS=10000
MCP_DB_LOCK_TIMEOUT_MS=3000
MCP_BLOCKING_TOOL_CONCURRENCY=16
MCP_BLOCKING_TOOL_QUEUE_TIMEOUT_MS=250
MCP_NEO4J_CONNECT_TIMEOUT_SECONDS=3
MCP_NEO4J_ACQUISITION_TIMEOUT_SECONDS=5
MCP_NEO4J_QUERY_TIMEOUT_SECONDS=10
MCP_NEO4J_POOL_SIZE=20
MCP_TEMPORAL_CONNECT_TIMEOUT_SECONDS=5
MCP_TEMPORAL_RPC_TIMEOUT_SECONDS=10

# Gateway upstream requests have separate total budgets. The caller's abort
# signal is composed with these deadlines so disconnects release downstream
# work while long uploads/downloads and chat streams keep realistic budgets.
GATEWAY_UPSTREAM_INTERACTIVE_TIMEOUT_MS=15000
GATEWAY_UPSTREAM_PROCESSING_TIMEOUT_MS=180000
GATEWAY_UPSTREAM_STREAM_TIMEOUT_MS=600000

# --- Exact original object storage ---
# Local setup generates these RustFS-only credentials. In production, leave
# static keys empty and use workload identity through the AWS credential chain.
OBJECT_STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=certus-originals
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_AUTO_CREATE_BUCKET=true
OBJECT_STORAGE_REQUIRE_VERSIONING=true
# Production may use aws:kms with a customer-managed key. The isolated local
# provider intentionally does not pretend to implement the KMS contract.
OBJECT_STORAGE_SERVER_SIDE_ENCRYPTION=
OBJECT_STORAGE_KMS_KEY_ID=
OBJECT_STORAGE_BUCKET_KEY_ENABLED=
# Durable upload recovery leases. An object write that outlives its request is
# adopted and finalized by any ingestion process that wins the PostgreSQL lease.
UPLOAD_RECONCILER_ENABLED=true
# Poll: 1-300 seconds; lease: 60-3600 seconds; attempts: 1-100;
# shutdown drain: 1-300 seconds. Invalid values fail service startup.
UPLOAD_RECONCILER_POLL_SECONDS=5
UPLOAD_RECONCILER_LEASE_SECONDS=300
UPLOAD_RECONCILER_MAX_ATTEMPTS=12
UPLOAD_RECONCILER_SHUTDOWN_SECONDS=30
INGESTION_PROCESSING_CONCURRENCY=4
INGESTION_PROCESSING_QUEUE_TIMEOUT_MS=500
INGESTION_DB_STATEMENT_TIMEOUT_MS=30000
INGESTION_DB_LOCK_TIMEOUT_MS=5000
INGESTION_NEO4J_CONNECT_TIMEOUT_SECONDS=3
INGESTION_NEO4J_ACQUISITION_TIMEOUT_SECONDS=5
INGESTION_NEO4J_QUERY_TIMEOUT_SECONDS=10
INGESTION_NEO4J_POOL_SIZE=20

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexus_neo4j_dev
NEO4J_CONNECTION_TIMEOUT_SECONDS=3
NEO4J_CONNECTION_ACQUIRE_TIMEOUT_SECONDS=2
NEO4J_MAX_CONNECTION_POOL_SIZE=12
NEO4J_QUERY_TIMEOUT_SECONDS=5

# --- Redis ---
REDIS_URL=redis://localhost:6379
# Successfully published real-time delivery ledger rows are retained for this
# many days. Pending publication rows are never removed by retention cleanup.
# Operational event-history windows are integer days from 1 through 3650.
NOTIFICATION_EVENT_RETENTION_DAYS=30
REALTIME_EVENT_RETENTION_DAYS=30
AUTOMATION_EVENT_RETENTION_DAYS=30
# Published outbox rows are retried until their consumer records completion.
OUTBOX_PUBLISHED_RECOVERY_SECONDS=300
# Terminal PostgreSQL embedding jobs retain compact diagnostics for this many days.
EMBEDDING_JOB_RETENTION_DAYS=7
# Duplicate deliveries wait for this recoverable PostgreSQL worker lease.
EMBEDDING_PROCESSING_LEASE_SECONDS=300
# Failed Redis embedding messages are bounded; chunk content remains authoritative in PostgreSQL.
EMBEDDING_DLQ_MAX_LENGTH=1000
# Background workers fail dependency attempts quickly, retry with capped backoff,
# and leave freshness/queue snapshots in PostgreSQL for production monitoring.
EMBEDDING_DB_CONNECT_TIMEOUT_SECONDS=3
EMBEDDING_REDIS_CONNECT_TIMEOUT_SECONDS=3
EMBEDDING_REDIS_SOCKET_TIMEOUT_SECONDS=5
WORKFLOWS_DB_CONNECT_TIMEOUT_SECONDS=3
WORKFLOWS_REDIS_CONNECT_TIMEOUT_SECONDS=3
WORKFLOWS_REDIS_SOCKET_TIMEOUT_SECONDS=5
WORKFLOWS_DEPENDENCY_CONNECT_TIMEOUT_SECONDS=5
WORKFLOWS_NEO4J_TIMEOUT_SECONDS=5
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_HEARTBEAT_STALE_SECONDS=30
WORKER_DB_STATEMENT_TIMEOUT_MS=15000
WORKER_DB_LOCK_TIMEOUT_MS=3000

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-5.4-mini
OPENAI_REASONING_MODEL=gpt-5.5
# Grounded generation is buffered until claim validation completes. Bound the
# provider wait and automatic retries so an outage cannot occupy a chat worker
# indefinitely or multiply calls without an explicit policy.
OPENAI_GENERATION_TIMEOUT_SECONDS=45
OPENAI_GENERATION_MAX_RETRIES=1
# Query embeddings are generated once per run and shared across compatible
# retrieval branches. Provider calls and database statements remain bounded.
OPENAI_EMBEDDING_TIMEOUT_SECONDS=10
OPENAI_EMBEDDING_MAX_RETRIES=1
# Document indexing has its own bounded provider budget because it runs outside
# the request-serving query path and may process larger batches.
OPENAI_INDEXING_TIMEOUT_SECONDS=30
OPENAI_INDEXING_MAX_RETRIES=1
ORCHESTRATION_RETRIEVAL_PARALLEL_WORKERS=12
ORCHESTRATION_RETRIEVAL_STAGE_TIMEOUT_SECONDS=8
ORCHESTRATION_RETRIEVAL_STATEMENT_TIMEOUT_MS=5000
# Measured filtered-HNSW accuracy policy. Raising these values increases query
# work and per-scan memory; lower values must clear `bun run eval:pgvector`.
RETRIEVAL_HNSW_EF_SEARCH=500
RETRIEVAL_HNSW_MAX_SCAN_TUPLES=200000
RETRIEVAL_HNSW_SCAN_MEM_MULTIPLIER=8
# Supported embedding spaces are text-embedding-3-small/large at 1536 dimensions.
# Changing this value requires an explicit measured reindex; existing vectors
# remain isolated under their original profile and are never silently mixed.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Finite cosine-similarity floor in [-1, 1]; invalid values fail startup.
RETRIEVAL_MIN_VECTOR_SIMILARITY=0.3
# Finite cosine-similarity floor in [-1, 1]; invalid values fail startup.
MEMORY_MIN_SIMILARITY=0.3

# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=nexus
TEMPORAL_TASK_QUEUE=certus-workflows

# --- Internal MCP transport ---
MCP_SERVER_URL=http://localhost:8003/mcp
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*
MCP_ALLOWED_ORIGINS=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LOG_LEVEL=debug

# --- Data portability ---
# The synchronous local fast path is bounded in compressed bytes, source JSON
# bytes, records, fetch batch size, and database time. Larger workspaces require
# an asynchronous object-storage export implementation.
MAX_EXPORT_ARCHIVE_BYTES=104857600
MAX_EXPORT_SOURCE_BYTES=67108864
MAX_EXPORT_RECORDS=250000
EXPORT_FETCH_BATCH_SIZE=250
EXPORT_STATEMENT_TIMEOUT_MS=150000

# --- Agent usage control ---
# Capacity held by each active run until its actual usage is persisted.
AGENT_RUN_TOKEN_RESERVATION=10000
AGENT_RUN_RESERVATION_TTL_MINUTES=15
